[Unit]
Description=MWM-AI Morning Brief — build + deploy to brief.mwmai.no
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/mats/services/morning-brief
Environment=SCCS_CONFORMAL_ENABLED=true
ExecStart=/usr/bin/python3 /home/mats/services/morning-brief/builder.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mwm-morning-brief
TimeoutStartSec=900

[Install]
WantedBy=default.target
