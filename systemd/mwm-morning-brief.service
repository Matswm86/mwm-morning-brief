[Unit]
Description=MWM-AI Morning Brief — build + deploy to brief.mwmai.no
After=network-online.target
Wants=network-online.target

[Service]
# liveness: heartbeat via ExecStopPost (P3.56)
ExecStopPost=%h/MWM/core/heartbeat/hb_stoppost.sh mwm-morning-brief daily
Type=oneshot
WorkingDirectory=%h/MWM/projects/mwm-morning-brief
Environment=SCCS_CONFORMAL_ENABLED=true
ExecStart=/usr/bin/python3 %h/MWM/projects/mwm-morning-brief/builder.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mwm-morning-brief
TimeoutStartSec=900

[Install]
WantedBy=default.target
